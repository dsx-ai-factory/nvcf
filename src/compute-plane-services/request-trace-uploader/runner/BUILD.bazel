load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "runner",
    srcs = [
        "logging.go",
        "runner.go",
    ],
    importpath = "github.com/dsx-ai-factory/nvcf/src/compute-plane-services/request-trace-uploader/runner",
    visibility = ["//visibility:public"],
    deps = [
        "//src/compute-plane-services/request-trace-uploader/backend",
        "//src/compute-plane-services/request-trace-uploader/config",
        "//src/compute-plane-services/request-trace-uploader/internal/atomicfile",
