        "//src/compute-plane-services/request-trace-uploader/uploadertest",
        "@io_opentelemetry_go_proto_otlp//collector/logs/v1:logs",
        "@io_opentelemetry_go_proto_otlp//collector/metrics/v1:metrics",
        "@io_opentelemetry_go_proto_otlp//collector/trace/v1:trace",
        "@org_golang_google_protobuf//proto",
