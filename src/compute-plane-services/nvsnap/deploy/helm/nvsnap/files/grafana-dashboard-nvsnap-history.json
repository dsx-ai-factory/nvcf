          },
          "expr": "histogram_quantile(0.5, sum by (le, phase) (rate(nvsnap_restore_phase_seconds_bucket{method=\"criu\", cluster=~\"$cluster\", gpu=~\"$gpu\", ranks=~\"$ranks\"}[$__rate_interval])))",
