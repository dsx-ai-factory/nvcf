      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (decision, reason) (increase(nvsnap_admissions_total{cluster=~\"$cluster\"}[$__interval]))",
          "legendFormat": "{{decision}} {{reason}}",
          "refId": "A"
        }
      ]
    }
  ]
}
