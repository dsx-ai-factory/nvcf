      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max by (cluster, bundle) (nvsnap_capture_records{state=\"complete\", cluster=~\"$cluster\"}))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "NvSnap alerts firing",
      "description": "NvSnap alerts firing now (docs/operate/RUNBOOK.md).",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
