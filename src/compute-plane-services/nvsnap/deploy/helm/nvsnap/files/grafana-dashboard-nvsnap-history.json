        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(ALERTS{alertname=~\"Nvsnap.*\", alertstate=\"firing\", cluster=~\"$cluster\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Scale-up: scheduled to Ready, by how the pod started",
      "id": 10,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Scheduled to Ready, p50",
      "description": "A GPU pod's time from being scheduled (given its GPUs) to Ready: the scale-up time. criu: restored; cachedir: seeded from a cache; cold: the baseline.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, method) (rate(nvsnap_pod_start_seconds_bucket{cluster=~\"$cluster\", gpu=~\"$gpu\", ranks=~\"$ranks\"}[$__rate_interval])))",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ]
    },
