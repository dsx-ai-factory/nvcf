{
  "kv": {
    "cassandra": {
      {{- with secret "/services/sis-api/kv/data/cassandra/creds" }}
      "username": "{{ .Data.data.username }}",
      "password": "{{ .Data.data.password }}"
      {{- end }}
    },
    "nkey_seed": "{{ with secret "/services/all/kv/data/nats/creds" }}{{ .Data.data.key }}{{ end }}",
    "tokens": {
      {{- with secret `services/api-keys-api/jwt/sign/sis-api` }}
      "api-keys": "{{ .Data.token }}",
      {{- end }}
      {{- with secret `services/event-ledger/jwt/sign/sis-api` }}
      "eventLedger": "{{ .Data.token }}"
      {{- end }}
    }
  }
}
